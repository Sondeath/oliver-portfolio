{
  "name": "oliver-portfolio",
  "main": "worker.js",
  "workers_dev": false,
  "preview_urls": true,
  "compatibility_date": "2026-10-13",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "INQUIRY_RATE_LIMIT",
      "namespace_id": "731029",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
